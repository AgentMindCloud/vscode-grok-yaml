{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://grokinstall.dev/schemas/grok-secret.schema.json",
  "title": "GrokInstall Secret",
  "description": "Secret reference — never stores plaintext; points at a secret manager entry.",
  "type": "object",
  "required": ["apiVersion", "kind", "metadata", "spec"],
  "additionalProperties": false,
  "properties": {
    "apiVersion": { "type": "string", "const": "grokinstall.dev/v1" },
    "kind": { "type": "string", "const": "Secret" },
    "metadata": { "$ref": "#/definitions/Metadata" },
    "spec": {
      "type": "object",
      "required": ["provider", "key"],
      "additionalProperties": false,
      "properties": {
        "provider": {
          "type": "string",
          "enum": ["env", "vault", "aws-sm", "gcp-sm", "azure-kv", "dotenv", "1password"]
        },
        "key": { "type": "string", "description": "Provider-side key or path. NEVER place secret values here." },
        "version": { "type": "string" },
        "scope": { "type": "array", "items": { "type": "string" }, "description": "Agents or workflows allowed to read this secret." }
      }
    }
  },
  "definitions": {
    "Metadata": {
      "type": "object",
      "required": ["name"],
      "properties": {
        "name": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]{0,62}$" },
        "namespace": { "type": "string" },
        "labels": { "type": "object", "additionalProperties": { "type": "string" } },
        "annotations": { "type": "object", "additionalProperties": { "type": "string" } }
      }
    }
  }
}
