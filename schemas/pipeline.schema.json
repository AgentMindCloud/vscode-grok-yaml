{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://grokinstall.dev/schemas/pipeline.schema.json",
  "title": "Grok Pipeline",
  "type": "object",
  "required": ["apiVersion", "kind", "metadata", "spec"],
  "properties": {
    "apiVersion": { "$ref": "./_common.schema.json#/definitions/apiVersion" },
    "kind": { "const": "Pipeline" },
    "metadata": { "$ref": "./_common.schema.json#/definitions/metadata" },
    "spec": {
      "type": "object",
      "required": ["stages"],
      "properties": {
        "trigger": {
          "type": "object",
          "properties": {
            "on": { "enum": ["manual", "schedule", "webhook", "event"] },
            "cron": { "type": "string" },
            "event": { "type": "string" }
          }
        },
        "stages": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": ["name", "run"],
            "properties": {
              "name": { "type": "string" },
              "run": { "type": "string" },
              "needs": {
                "type": "array",
                "items": { "type": "string" }
              }
            },
            "additionalProperties": false
          }
        }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
