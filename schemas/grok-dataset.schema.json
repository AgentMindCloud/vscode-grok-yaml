{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://grokinstall.dev/schemas/grok-dataset.schema.json",
  "title": "GrokInstall Dataset",
  "description": "Declares a dataset used for training, evaluation, or fine-tuning.",
  "type": "object",
  "required": ["apiVersion", "kind", "metadata", "spec"],
  "additionalProperties": false,
  "properties": {
    "apiVersion": { "type": "string", "const": "grokinstall.dev/v1" },
    "kind": { "type": "string", "const": "Dataset" },
    "metadata": { "$ref": "#/definitions/Metadata" },
    "spec": {
      "type": "object",
      "required": ["source"],
      "additionalProperties": false,
      "properties": {
        "description": { "type": "string" },
        "source": {
          "type": "object",
          "properties": {
            "type": { "type": "string", "enum": ["local", "s3", "gcs", "azure", "http", "huggingface"] },
            "uri": { "type": "string" },
            "format": { "type": "string", "enum": ["jsonl", "csv", "parquet", "arrow", "txt"] }
          }
        },
        "schema": { "type": "object", "additionalProperties": true },
        "splits": {
          "type": "object",
          "additionalProperties": { "type": "string", "description": "URI or selector for this split." }
        },
        "license": { "type": "string" }
      }
    }
  },
  "definitions": {
    "Metadata": {
      "type": "object",
      "required": ["name"],
      "properties": {
        "name": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]{0,62}$" },
        "namespace": { "type": "string" },
        "labels": { "type": "object", "additionalProperties": { "type": "string" } },
        "annotations": { "type": "object", "additionalProperties": { "type": "string" } }
      }
    }
  }
}
