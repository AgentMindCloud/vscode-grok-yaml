{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://grokinstall.dev/schemas/grok-deploy.schema.json",
  "title": "GrokInstall Deploy",
  "description": "Deployment descriptor — target environment, scaling, and runtime config.",
  "type": "object",
  "required": ["apiVersion", "kind", "metadata", "spec"],
  "additionalProperties": false,
  "properties": {
    "apiVersion": { "type": "string", "const": "grokinstall.dev/v1" },
    "kind": { "type": "string", "const": "Deploy" },
    "metadata": { "$ref": "#/definitions/Metadata" },
    "spec": {
      "type": "object",
      "required": ["target", "artifact"],
      "additionalProperties": false,
      "properties": {
        "target": { "type": "string", "enum": ["local", "docker", "kubernetes", "serverless", "vercel", "fly", "custom"] },
        "artifact": {
          "type": "object",
          "properties": {
            "agent": { "type": "string" },
            "workflow": { "type": "string" },
            "image": { "type": "string" }
          }
        },
        "replicas": { "type": "integer", "minimum": 0 },
        "env": { "type": "object", "additionalProperties": { "type": "string" } },
        "secrets": { "type": "array", "items": { "type": "string" } },
        "resources": {
          "type": "object",
          "properties": {
            "cpu": { "type": "string" },
            "memory": { "type": "string" },
            "gpu": { "type": "string" }
          }
        }
      }
    }
  },
  "definitions": {
    "Metadata": {
      "type": "object",
      "required": ["name"],
      "properties": {
        "name": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]{0,62}$" },
        "namespace": { "type": "string" },
        "labels": { "type": "object", "additionalProperties": { "type": "string" } },
        "annotations": { "type": "object", "additionalProperties": { "type": "string" } }
      }
    }
  }
}
