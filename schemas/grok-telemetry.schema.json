{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://grokinstall.dev/schemas/grok-telemetry.schema.json",
  "title": "GrokInstall Telemetry",
  "description": "Telemetry / observability configuration — sinks, samplers, and tracing.",
  "type": "object",
  "required": ["apiVersion", "kind", "metadata", "spec"],
  "additionalProperties": false,
  "properties": {
    "apiVersion": { "type": "string", "const": "grokinstall.dev/v1" },
    "kind": { "type": "string", "const": "Telemetry" },
    "metadata": { "$ref": "#/definitions/Metadata" },
    "spec": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "description": { "type": "string" },
        "sinks": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["type"],
            "properties": {
              "type": { "type": "string", "enum": ["otlp", "jaeger", "datadog", "honeycomb", "file", "stdout"] },
              "endpoint": { "type": "string" },
              "headers": { "type": "object", "additionalProperties": { "type": "string" } }
            }
          }
        },
        "sampling": {
          "type": "object",
          "properties": {
            "rate": { "type": "number", "minimum": 0, "maximum": 1 },
            "strategy": { "type": "string", "enum": ["always", "ratio", "parent-based"] }
          }
        },
        "redact": {
          "type": "array",
          "items": { "type": "string", "description": "JSON path or field name to redact from telemetry payloads." }
        }
      }
    }
  },
  "definitions": {
    "Metadata": {
      "type": "object",
      "required": ["name"],
      "properties": {
        "name": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]{0,62}$" },
        "namespace": { "type": "string" },
        "labels": { "type": "object", "additionalProperties": { "type": "string" } },
        "annotations": { "type": "object", "additionalProperties": { "type": "string" } }
      }
    }
  }
}
