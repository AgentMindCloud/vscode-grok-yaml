{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://grokinstall.dev/schemas/workflow.schema.json",
  "title": "Grok Workflow",
  "type": "object",
  "required": ["apiVersion", "kind", "metadata", "spec"],
  "properties": {
    "apiVersion": { "$ref": "./_common.schema.json#/definitions/apiVersion" },
    "kind": { "const": "Workflow" },
    "metadata": { "$ref": "./_common.schema.json#/definitions/metadata" },
    "spec": {
      "type": "object",
      "required": ["steps"],
      "properties": {
        "inputs": {
          "type": "object",
          "additionalProperties": {
            "type": "object",
            "properties": {
              "type": { "type": "string" },
              "required": { "type": "boolean" },
              "default": {}
            }
          }
        },
        "steps": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": ["id", "uses"],
            "properties": {
              "id": { "type": "string" },
              "uses": { "type": "string", "description": "Reference to agent/tool/workflow." },
              "with": { "type": "object" },
              "if": { "type": "string" },
              "out": { "type": "string" }
            },
            "additionalProperties": false
          }
        },
        "outputs": {
          "type": "object",
          "additionalProperties": { "type": "string" }
        }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
